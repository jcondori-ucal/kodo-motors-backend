{
  "name": "kodo-motor-backend",
  "version": "1.0.0",
  "description": "API REST por capas de Kodo Motors: sedes, servicios, catálogo, reservas, repuestos y encuestas con Node.js, Express y MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integracion": "jest --runInBand tests/integracion",
    "test:watch": "jest --watch tests/unit",
    "cobertura": "jest --runInBand --coverage",
    "test:suite": "node test-suite.js",
    "test:todo": "node test-suite.js && jest --runInBand",
    "test:postman": "npx newman run postman/kodo-motors-manejo-errores.postman_collection.json",
    "test:postman:sedes-servicios": "npx newman run postman/kodo-sedes-servicios-pruebas.postman_collection.json",
    "bd:levantar": "docker compose up -d",
    "bd:detener": "docker compose down",
    "bd:reiniciar": "docker compose down -v && docker compose up -d"
  },
  "keywords": [
    "kodo-motors",
    "api-rest",
    "express",
    "mysql",
    "ucal"
  ],
  "author": "Equipos E03, u2 y Grupo1-4 · EE2 Fundamentos de Desarrollo Back-End, UCAL",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "~2.8.5",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "express-validator": "^7.3.2",
    "mysql2": "~3.24.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "~3.1.14",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/middlewares/**/*.js",
      "src/validators/common.js",
      "src/validators/validar.js",
      "src/validators/sedes.validators.js",
      "src/validators/servicios.validators.js",
      "src/models/sede.model.js",
      "src/models/servicio.model.js",
      "src/services/sedes.service.js",
      "src/services/servicios.service.js",
      "src/controllers/sedes.controller.js",
      "src/controllers/servicios.controller.js",
      "src/routes/sedes.routes.js",
      "src/routes/servicios.routes.js"
    ]
  }
}
