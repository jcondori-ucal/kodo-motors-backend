{
  "name": "kodo-motor-backend",
  "version": "1.0.0",
  "description": "API REST por capas de Kodo Motors: sedes, servicios, catálogo, reservas, repuestos y encuestas con Node.js, Express y MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:postman": "npx newman run postman/kodo-motors-manejo-errores.postman_collection.json",
    "bd:levantar": "docker compose up -d",
    "bd:detener": "docker compose down",
    "bd:reiniciar": "docker compose down -v && docker compose up -d",
    "test:unit": "jest --runInBand tests/unit",
    "cobertura": "jest --runInBand --coverage tests/unit"
  },
  "keywords": [
    "kodo-motors",
    "api-rest",
    "express",
    "mysql",
    "ucal"
  ],
  "author": "Equipos E03, u2 y Grupo1-4 · EE2 Fundamentos de Desarrollo Back-End, UCAL",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "~2.8.5",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "express-validator": "^7.3.2",
    "mysql2": "~3.24.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "~3.1.14"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/models/reserva.model.js",
      "src/services/reserva.service.js"
    ]
  }
}
